{% comment %}
  Shows subscription plan info (discount, interval, extra settings badges)
  on the product page storefront.
{% endcomment %}

{% assign selling_plan_group = product.selling_plan_groups.first %}

{% if selling_plan_group %}
  <div class="subscription-widget" style="border:1px solid #e5e7eb; border-radius:10px; padding:16px; margin:16px 0;">
    <h4 style="margin:0 0 8px; font-size:15px;">📦 {{ selling_plan_group.name }}</h4>

    {% for plan in selling_plan_group.selling_plans %}
      <div style="display:flex; align-items:center; gap:8px; font-size:13px; margin-bottom:6px;">
        <span>📅 {{ plan.name }}</span>
        {% for adjustment in plan.price_adjustments %}
          {% if adjustment.value_type == "percentage" %}
            <span style="background:#d1fae5;color:#065f46;padding:2px 8px;border-radius:10px;">
              -{{ adjustment.value }}% off
            </span>
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}

    {% if block.settings.show_note %}
      <p style="font-size:12px;color:#6b7280;margin-top:8px;">
        {{ block.settings.note_text }}
      </p>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Subscription Widget",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "Show note below plans",
      "default": true
    },
    {
      "type": "text",
      "id": "note_text",
      "label": "Note text",
      "default": "Cancel anytime. Discounts may change after your first order."
    }
  ]
}
{% endschema %}